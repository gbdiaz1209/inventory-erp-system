    "/api/inventorymovement/register": {
      "post": {
        "tags": [
          "InventoryMovement"
        ],
        "summary": "Registra un nuevo movimiento de inventario.",
        "description": "Este endpoint valida que el producto exista y que haya stock suficiente \r\nen caso de ser una Salida.",
        "requestBody": {
          "description": "DTO con ProductId, Quantity y Type (0=Entrada, 1=Salida).",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InventoryMovementCreateDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/InventoryMovementCreateDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/InventoryMovementCreateDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "El movimiento fue registrado y el stock actualizado."
          },
          "400": {
            "description": "Datos inválidos o stock insuficiente."
          }
        }
      }
    },
